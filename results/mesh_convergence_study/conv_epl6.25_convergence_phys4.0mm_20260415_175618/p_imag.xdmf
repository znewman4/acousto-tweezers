<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Tetrahedron" NumberOfElements="497664" NodesPerElement="4">
        <DataItem Dimensions="497664 4" NumberType="Int" Format="HDF">p_imag.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="88837 3" Format="HDF">p_imag.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="p_imag" GridType="Collection" CollectionType="Temporal">
      <Grid Name="p_imag" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="real_p_imag" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="88837 1" Format="HDF">p_imag.h5:/Function/real_p_imag/0</DataItem>
        </Attribute>
        <Attribute Name="imag_p_imag" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="88837 1" Format="HDF">p_imag.h5:/Function/imag_p_imag/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
